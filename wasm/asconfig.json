{
  "targets": {
    "release": {
      "outFile": "dsp.wasm",
      "textFile": "dsp.wat",
      "optimizeLevel": 3,
      "shrinkLevel": 0,
      "converge": false,
      "noAssert": true,
      "runtime": "incremental"
    },
    "debug": {
      "outFile": "dsp.debug.wasm",
      "sourceMap": true,
      "debug": true
    }
  },
  "options": {
    "bindings": false,
    "exportRuntime": false,
    "initialMemory": 2,
    "maximumMemory": 16
  }
}
