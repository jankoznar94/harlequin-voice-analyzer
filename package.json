{
  "name": "analýza-zpevniho-hlasu",
  "version": "0.1.0",
  "private": true,
  "description": "Akustická analýza zpěvního hlasu v prohlížeči — ring, formanty a barva hlasu. Bez serveru, bez závislostí.",
  "type": "module",
  "scripts": {
    "start": "node serve.mjs 8123",
    "build:wasm": "bash wasm/build.sh",
    "test": "node test/test-dsp.mjs && node test/test-pipeline.mjs",
    "test:dsp": "node test/test-dsp.mjs",
    "test:pipeline": "node test/test-pipeline.mjs",
    "test:live": "node test/test-live-wiring.mjs",
    "test:smooth": "node test/test-live-smooth.mjs",
    "test:fhe": "node test/test-fhe.mjs",
    "test:decode": "node test/test-decode.mjs",
    "test:band": "node test/test-band.mjs",
    "test:sample-rate": "node test/test-sample-rate.mjs",
    "test:eta": "node test/test-eta.mjs",
    "test:parity": "node test/test-live-parity.mjs",
    "test:buffer": "node test/test-live-buffer.mjs",
    "test:live-vtl": "node test/test-live-vtl.mjs",
    "test:live-spec": "node test/test-live-spektrogram.mjs",
    "test:live-spec-render": "node test/test-live-spektrogram-render.mjs",
    "test:all": "for t in dsp fhe band vtl vyrazene mezery slouceni spr-serie trend-ui sample-rate eta pipeline ui-wiring spec sw-update sw-rescue playhead player-wiring nahravani-ui hlaska-rozsah osa-dur decode live-wiring live-smooth live-parity live-buffer live-vtl live-spec live-spec-render smoke-browser; do node test/test-$t.mjs || exit 1; done",
    "check:parity": "node tools/parity.mjs check",
    "check:wasm": "node tools/wasm-parity.mjs",
    "check:live": "node tools/live-check.mjs",
    "verify": "node test/verify.mjs",
    "test:sw-rescue": "node test/test-sw-rescue.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["voice", "singing", "dsp", "formant", "spectrogram", "praat", "pwa", "wasm"],
  "license": "MIT"
}
